{/* Currency Selector Switcher Bar (Simulating settings switcher) */}
            <div className="flex items-center justify-between rounded-2xl bg-gray-100 px-4 py-2.5 dark:bg-white/[0.04] border border-gray-200 dark:border-white/10">
                <span className="text-xs font-medium text-gray-500 dark:text-gray-400">Display Currency:</span>
                <div className="flex items-center gap-1.5">
                    {(["USD", "EUR", "GBP", "NGN"] as CurrencyType[]).map((curr) => (
                        <button
                            key={curr}
                            type="button"
                            onClick={() => setCurrency(curr)}
                            className={`rounded-lg px-2.5 py-1 text-xs font-semibold transition ${
                                currency === curr
                                    ? "bg-emerald-600 text-white shadow-sm"
                                    : "bg-white text-gray-700 hover:bg-gray-100 dark:bg-white/10 dark:text-gray-300 dark:hover:bg-white/20"
                            }`}
                        >
                            {curr}
                        </button>
                    ))}
                </div>
            </div>
